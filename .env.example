# Moyklass CRM API key (Settings -> API). Server-side only; enables the custom schedule on /raspisanie/.
MOYKLASS_API_KEY=
# Set to 1 (without an API key) to render the schedule from local fixtures during development.
MOYKLASS_MOCK=

# Payload CMS admin panel (/upravlenie/).
# Long random string used to sign sessions and encrypt data. Required. Generate: openssl rand -hex 32
PAYLOAD_SECRET=
# SQLite database file. Keep it on a persistent volume in production.
DATABASE_URI=file:./data/payload.db
# Directory for uploaded media (default: ./data/media). Keep it on a persistent volume in production.
PAYLOAD_MEDIA_DIR=
# Public origin of the site; used for Payload CSRF/CORS allow-lists.
NEXT_PUBLIC_SERVER_URL=http://localhost:3000
# Optional: bun run seed creates the first admin from these if no user exists yet.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
