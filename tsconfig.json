{
	"compilerOptions": {
		"target": "ES2022",
		"lib": ["dom", "dom.iterable", "esnext"],
		"allowJs": true,
		"skipLibCheck": true,
		"strict": true,
		"noEmit": true,
		"esModuleInterop": true,
		"module": "esnext",
		"moduleResolution": "bundler",
		"resolveJsonModule": true,
		"isolatedModules": true,
		"jsx": "react-jsx",
		"incremental": true,
		"paths": {
			"@/*": ["./src/*"],
			"@payload-config": ["./src/payload.config.ts"]
		},
		"plugins": [
			{
				"name": "next"
			}
		],
		"baseUrl": "."
	},
	"include": [
		"**/*.ts",
		"**/*.tsx",
		"next-env.d.ts",
		".next/types/**/*.ts",
		"next.config.ts",
		".eslintrc.cjs",
		"postcss.config.mjs",
		".next/dev/types/**/*.ts"
	],
	"exclude": ["node_modules", "file.tsx"]
}
