{
	"name": "persona",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "next dev --turbopack",
		"build": "next build",
		"start": "next start",
		"lint": "eslint . --ext .ts,.tsx,.js,.jsx && bun scripts/check-class-collisions.ts",
		"lint:fix": "eslint . --ext .ts,.tsx,.js,.jsx --fix",
		"format:check": "prettier --check .",
		"typecheck": "tsc --noEmit",
		"check:search": "NODE_OPTIONS=--conditions=react-server payload run scripts/check-search.ts",
		"prepare": "lefthook install",
		"payload": "payload",
		"generate:types": "payload generate:types",
		"generate:importmap": "payload generate:importmap",
		"seed": "payload run scripts/seed-cms.ts",
		"seed:reset": "SEED_RESET=1 payload run scripts/seed-cms.ts",
		"check:cms": "NODE_OPTIONS=--conditions=react-server payload run scripts/check-cms-parity.ts",
		"migrate": "payload migrate"
	},
	"dependencies": {
		"@headlessui/react": "^2.2.10",
		"@payloadcms/db-sqlite": "3.94.2",
		"@payloadcms/next": "3.94.2",
		"@payloadcms/translations": "3.94.2",
		"@payloadcms/ui": "3.94.2",
		"@react-three/drei": "^10.7.9",
		"@react-three/fiber": "^9.8.2",
		"graphql": "^16",
		"lucide-react": "^1.77.0",
		"minisearch": "^7.2.0",
		"next": "16.4.6",
		"payload": "3.94.2",
		"react": "^19.2.9",
		"react-dom": "^19.2.9",
		"server-only": "^0.0.1",
		"sharp": "^0.35.5",
		"three": "^0.187.0"
	},
	"devDependencies": {
		"@next/eslint-plugin-next": "^15.3.3",
		"@tailwindcss/postcss": "^4",
		"@types/node": "^22",
		"@types/react": "^19",
		"@types/react-dom": "^19",
		"@types/three": "^0.187.0",
		"@typescript-eslint/eslint-plugin": "^7.8.0",
		"@typescript-eslint/parser": "^7.8.0",
		"eslint": "8.57.1",
		"eslint-config-prettier": "^9.1.0",
		"eslint-import-resolver-typescript": "^3.7.0",
		"eslint-plugin-import": "^2.29.1",
		"eslint-plugin-react": "^7.34.1",
		"eslint-plugin-react-hooks": "^4.6.2",
		"eslint-plugin-unused-imports": "3.2.0",
		"lefthook": "^1",
		"prettier": "^3",
		"prettier-plugin-tailwindcss": "^0.6",
		"tailwindcss": "^4",
		"typescript": "~5.5.0"
	}
}
