{
	"name": "persona",
	"version": "0.1.0",
	"private": true,
	"scripts": {
		"dev": "next dev --turbopack",
		"build": "next build",
		"start": "next start",
		"lint": "eslint . --ext .ts,.tsx,.js,.jsx && bun scripts/check-class-collisions.ts",
